# FundPilot Environment Configuration
# All storage is 100% local (IndexedDB). No database connection required.
# Live quotes & FX use free, keyless public proxies by default.

# Optional Cloud LLM (Opt-in only. On-device categorization is used by default)
# Plain warning is displayed before sending any data to a remote cloud LLM.
OPTIONAL_CLOUD_LLM_API_KEY=placeholder_optional_llm_key_not_required
OPTIONAL_CLOUD_LLM_MODEL=gpt-4o-mini
